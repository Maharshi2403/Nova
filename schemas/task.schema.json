{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-harness.invalid/schemas/v1/task.schema.json",
  "title": "HarnessTaskProposalV1",
  "description": "Task proposed by intelligence layer; only Rust decides when it can execute.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "complexity", "risk", "agent_priority", "manual_priority", "dependencies", "candidate_paths", "acceptance", "limits"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "title": {"type": "string", "minLength": 3, "maxLength": 200},
    "description": {"type": "string", "minLength": 10, "maxLength": 8000},
    "complexity": {"enum": ["low", "medium", "high"]},
    "risk": {"enum": ["low", "medium", "high"]},
    "agent_priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "manual_priority": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 100}, {"type": "null"}]},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_paths": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1024}, "maxItems": 100},
    "acceptance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": {
          "kind": {"enum": ["test", "assertion"]},
          "command": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "maxLength": 1024}},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "oneOf": [
          {"properties": {"kind": {"const": "test"}}, "required": ["command"]},
          {"properties": {"kind": {"const": "assertion"}}, "required": ["description"]}
        ]
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_tool_calls", "max_output_tokens", "timeout_seconds", "cost_cap_usd"],
      "properties": {
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "cost_cap_usd": {"type": "number", "minimum": 0}
      }
    }
  }
}
