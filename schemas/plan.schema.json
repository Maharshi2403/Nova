{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-harness.invalid/schemas/v1/plan.schema.json",
  "title": "HarnessPlanProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "idea", "assumptions", "requirements", "architecture", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "idea": {"type": "string", "minLength": 5, "maxLength": 16000},
    "assumptions": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "architecture": {
      "type": "object", "additionalProperties": false,
      "required": ["recommended", "alternatives", "risks"],
      "properties": {
        "recommended": {"type": "string", "minLength": 10},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tasks": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "task.schema.json"}}
  }
}
